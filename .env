# Example .env file to use, rename this file to .env

# NEDAP reader network settings
TCP_SCANNER_PORT=7000 # Replace with correct port (check NEDAP config)
TCP_HOST_SCANNER1=10.207.207.244 # Replace with NEDAP reader's IP

# MySQL Server connection settings
DB_MESSAGE_TABLE=messages
DB_DIALECT=mssql
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_HOST=127.0.0.1
DB_PORT=1433
DB_NAME=test
DB_USER=test
DB_PASSWORD=C@T$cats

# Linux-specific: location of mysql driver
DRIVER_PATH = "/usr/lib/x86_64-linux-gnu/odbc/libmyodbc9w.so"
