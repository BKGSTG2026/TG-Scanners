# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
venv/
env/
ENV/
.venv/
.env/

# IDE / editor files
.vscode/
.idea/
*.swp
*.swo

# Logs and temp files
*.log
*.tmp
*.bak

# Ignore everything else
*

# But keep Python source files
!*.py
!*/  # keep directories so that Python files inside are tracked

