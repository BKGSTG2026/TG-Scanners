    {
        "id": "parser_node",
        "type": "function",
        "z": "69f1b543316e8882",
        "name": "Clean & Format Data",
        "func": "// Clean the hex string\nlet raw = msg.payload.toString();\nlet cleanTag = raw.replace(/[^a-zA-Z0-9]/g, \"\");\n\nmsg.payload = {\n    tag: cleanTag,\n    scanner: msg.topic || \"Unknown_Gate\",\n    timestamp: new Date().toISOString()\n};\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 520,
        "y": 230,
        "wires": [
            [
                "debug_console",
                "file_logger"
            ]
        ]
    },
