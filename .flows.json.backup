        "func": "// Extract ID and add metadata\nlet raw = msg.payload.toString();\nmsg.payload = {\n    tag: raw.replace(/[^a-zA-Z0-9]/g, ''),\n    scanner: \"Test_Bench_1\",\n    timestamp: new Date().toISOString()\n};\nreturn msg;",
